{
  "name": "@extravision/extension-chat",
  "version": "1.0.0",
  "description": "Study-level AI assistant chat panel for OHIF",
  "author": "ExtraVision",
  "license": "MIT",
  "main": "dist/extravision-extension-chat.umd.js",
  "module": "src/index.tsx",
  "files": [
    "dist/**",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "yarn": ">=1.20.0"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "start": "yarn run dev"
  },
  "peerDependencies": {
    "@ohif/core": "3.13.0-beta.58",
    "@ohif/extension-default": "3.13.0-beta.58",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@babel/runtime": "7.28.2"
  }
}
